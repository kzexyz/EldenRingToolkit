<Window x:Class="KsEldenRingToolkitManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KsEldenRingToolkitManager"
        mc:Ignorable="d"
        Title="Elden Ring Toolkit"
        Height="760"
        Width="1180"
        MinHeight="650"
        MinWidth="980"
        Background="{DynamicResource BgMain}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="False"
        RenderOptions.EdgeMode="Unspecified"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="BgMain" Color="#0D1012"/>
        <SolidColorBrush x:Key="BgPanel" Color="#14181B"/>
        <SolidColorBrush x:Key="BgPanel2" Color="#181D20"/>
        <SolidColorBrush x:Key="BgHover" Color="#20262A"/>
        <SolidColorBrush x:Key="BgPressed" Color="#292F33"/>
        <SolidColorBrush x:Key="BorderMain" Color="#343B3F"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#2A3034"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8E3D6"/>
        <SolidColorBrush x:Key="TextSoft" Color="#AAA69C"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7F837E"/>
        <SolidColorBrush x:Key="Accent" Color="#B78D36"/>
        <SolidColorBrush x:Key="AccentBright" Color="#D0A64F"/>
        <SolidColorBrush x:Key="AccentSelection" Color="#332A18"/>
        <SolidColorBrush x:Key="AccentButton" Color="#6E5524"/>
        <SolidColorBrush x:Key="AccentButtonHover" Color="#80652B"/>
        <SolidColorBrush x:Key="DropBorder" Color="#365A68"/>
        <SolidColorBrush x:Key="DropHover" Color="#1D2C34"/>
        <SolidColorBrush x:Key="DropSelected" Color="#27414C"/>
        <SolidColorBrush x:Key="DropArrow" Color="#78A8BE"/>
        <SolidColorBrush x:Key="DropItemText" Color="#DDE5E8"/>
        <Style x:Key="SavePickerItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSelection}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SavePickerSelectButton" TargetType="Button">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="{DynamicResource AccentButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PickerButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentButtonHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSelection}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource BgPanel2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Opacity" Value="0.52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody"
                                        Property="Background"
                                        Value="{DynamicResource TextSoft}"/>
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody"
                                        Property="Background"
                                        Value="{DynamicResource AccentBright}"/>
                                <Setter Property="Opacity" Value="0.90"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot"
                              Background="Transparent"
                              Margin="0">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Height" Value="10"/>
                                <Setter Property="MinHeight" Value="10"/>
                                <Setter TargetName="PART_Track"
                                        Property="IsDirectionReversed"
                                        Value="False"/>
                                <Setter TargetName="DecreaseButton"
                                        Property="Command"
                                        Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="IncreaseButton"
                                        Property="Command"
                                        Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollRoot"
                                        Property="Background"
                                        Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent"
                              SnapsToDevicePixels="False">
                            <ContentPresenter x:Name="TopContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="TopHoverIndicator"
                                    Width="22"
                                    Height="1"
                                    CornerRadius="1"
                                    Background="{DynamicResource TextMuted}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,3"
                                    Opacity="0"
                                    SnapsToDevicePixels="False"/>
                            <Border x:Name="TopActiveIndicator"
                                    Width="34"
                                    Height="2"
                                    CornerRadius="1"
                                    Background="{DynamicResource AccentBright}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,2"
                                    Opacity="0"
                                    SnapsToDevicePixels="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopHoverIndicator" Property="Opacity" Value="0.72"/>
                                <Setter TargetName="TopContent" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopHoverIndicator" Property="Width" Value="30"/>
                                <Setter TargetName="TopHoverIndicator" Property="Height" Value="2"/>
                                <Setter TargetName="TopHoverIndicator" Property="Background" Value="{DynamicResource AccentBright}"/>
                                <Setter TargetName="TopHoverIndicator" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="BorderThickness" Value="0,0,0,2">
                                <Setter TargetName="TopActiveIndicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="TopHoverIndicator" Property="Opacity" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DropHover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DropSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="#FFF9EA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSelection}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="False">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DropBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource DropItemText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7"
                                SnapsToDevicePixels="False">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource DropHover}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource DropSelected}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextMain}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{DynamicResource BgPanel}"
                                          BorderBrush="{DynamicResource BorderMain}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter
                                                    Grid.Column="0"
                                                    Margin="12,0,8,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Content="{Binding SelectionBoxItem,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                                              RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    TextElement.Foreground="{DynamicResource TextMain}"/>
                                                <Border Grid.Column="1"
                                                        BorderBrush="{DynamicResource BorderMain}"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="8"
                                                          Height="5"
                                                          Fill="{DynamicResource DropArrow}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource DropSelected}"/>
                                                <Setter TargetName="MainBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource DropBorder}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource DropBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource BgPanel2}"
                                        BorderBrush="{DynamicResource DropBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="1"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300">
                                    <ScrollViewer
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkEditableComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{DynamicResource BgPanel}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="12,0,8,0"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Left"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextMain}"
                                             BorderThickness="0"
                                             CaretBrush="{DynamicResource AccentBright}"
                                             SelectionBrush="{DynamicResource AccentSelection}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Text="{Binding Text,
                                                            RelativeSource={RelativeSource TemplatedParent},
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"/>
                                    <ToggleButton x:Name="DropButton"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Cursor="Hand"
                                                  Background="Transparent"
                                                  BorderBrush="{DynamicResource BorderMain}"
                                                  BorderThickness="1,0,0,0"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                                      Mode=TwoWay,
                                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ArrowBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Path Width="8"
                                                          Height="5"
                                                          Fill="{DynamicResource DropArrow}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ArrowBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource DropSelected}"/>
                                                        <Setter TargetName="ArrowBorder"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource DropBorder}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ArrowBorder"
                                                                Property="Background"
                                                                Value="{DynamicResource DropSelected}"/>
                                                        <Setter TargetName="ArrowBorder"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource DropBorder}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource BgPanel2}"
                                        BorderBrush="{DynamicResource DropBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="1"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300">
                                    <ScrollViewer
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource DropBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanel2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="ToolkitRoot" Background="{DynamicResource BgMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSoft}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="245"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="18,0,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="Georgia"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   LineHeight="17">
                            <Run Text="Elden Ring"
                                 Foreground="{DynamicResource AccentBright}"
                                 FontWeight="Bold"/>
                            <Run Text=" Toolkit"
                                 Foreground="{DynamicResource TextMain}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Segoe UI"
                                   FontSize="9.5"
                                   Margin="1,-1,0,0"
                                   Foreground="{DynamicResource TextMuted}">
                            <Run Text="by "/>
                            <Run Text="EldenKane"
                                 Foreground="{DynamicResource Accent}"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch">
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                    <Button x:Name="CharacterButton"
                            Content="Character"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                    <Button x:Name="InventoryButton"
                            Content="Inventory"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                    <Button x:Name="PresetsButton"
                            Content="Presets"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                    <Button x:Name="SkinButton"
                            Content="Skin"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Margin="0,0,8,0">
                    <Button x:Name="AboutButton"
                            Content="About"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Style="{StaticResource TopButton}"
                            Click="TopNavigation_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderSoft}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="SidebarPanel" Grid.Row="0"/>
                    <Grid Grid.Row="1" Margin="14,10,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Discord Server"
                                Style="{StaticResource ActionButton}"
                                Height="32"
                                Padding="10,4"
                                Click="DiscordServerSidebarButton_Click"/>
                        <Button Grid.Column="2"
                                Content="Donate"
                                Style="{StaticResource PrimaryButton}"
                                Height="32"
                                Padding="10,4"
                                Click="DonateSidebarButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1"
                  Background="{DynamicResource BgMain}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ContentHost"
                          Margin="28,24,28,32"/>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.Row="2"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderMain}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
                <TextBlock Text="Elden Ring Toolkit  •  by EldenKane"
                           Foreground="{DynamicResource TextMuted}"
                           FontFamily="Georgia"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0"/>
            </Grid>
        </Border>
        <Border x:Name="ToastHost"
                Grid.RowSpan="3"
                Width="360"
                MinHeight="58"
                MaxHeight="110"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,22,52"
                Padding="14,11"
                Background="{DynamicResource BgPanel2}"
                BorderBrush="{DynamicResource Accent}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="1000">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" X="28"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ToastIcon"
                           Grid.Column="0"
                           Text="i"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBright}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="ToastMessage"
                           Grid.Column="1"
                           Text=""
                           Foreground="{DynamicResource TextMain}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
