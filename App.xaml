<Application x:Class="KsEldenRingToolkitManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KsEldenRingToolkitManager"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/EldenRingToolkit.ico"/>
        <Style TargetType="{x:Type Window}">
            <Setter Property="Icon" Value="{StaticResource AppIcon}"/>
        </Style>
    </Application.Resources>
</Application>
