<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>KsEldenRingToolkitManager</RootNamespace>
    <AssemblyName>Elden Ring Toolkit</AssemblyName>
    <AssemblyTitle>Elden Ring Toolkit</AssemblyTitle>
    <Product>Elden Ring Toolkit</Product>
    <ApplicationIcon>Assets\EldenRingToolkit.ico</ApplicationIcon>
    <Version>1.0.0-beta</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0b</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\EldenRingToolkit.ico"/>
    <Content Include="Data\ItemIcons.kspack">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0"/>
    <PackageReference Include="BCnEncoder.Net.ImageSharp" Version="1.1.3"/>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8"/>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Libs\Andre.Formats.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Libs\ZstdNet.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Libs\libzstd.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Libs\Andre.SoulsFormats.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Libs\BouncyCastle.Cryptography.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Data\ParamDefs\EquipParamProtector.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="Data\ParamDefs\EquipParamWeapon.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
